  "name": "Fetch Items Awaiting Inspection",
  "description": "Helps the warehouse operations manager to fetch the items that are awaiting inspection in an Organization. The Organization ID will be the input to this business object.",
  "objectCode": "ORA_SCM_INVENTORYM_XX_FETCHITEMSAWAITINGINSPECTION",
  "family": "SCM",
